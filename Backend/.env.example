# Copia este archivo a ".env" (en esta misma carpeta, Backend/) y ajusta los valores.
# ".env" ya está en el .gitignore raíz, nunca se sube al repo.

# Credenciales de la base de datos local (deben coincidir con docker-compose.yml).
DB_USERNAME=shiftsystem
DB_PASSWORD=shiftsystem_dev_local

# Cloudinary (subida de fotos de colaboradores). Opcional para desarrollo:
# sin esto la app funciona igual, pero la subida de fotos va a fallar.
# Crea una cuenta gratuita en https://cloudinary.com/ y pega tus datos del dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Autenticación (Etapa 1 - JWT mínimo)
# Generá un secreto propio, no reutilices el de otro entorno.
# Ejemplo para generarlo: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_SECRET=
# Usuario ADMIN que se crea solo al arrancar si no existe (no hay registro público).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
