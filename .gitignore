# Ignorar archivos y carpetas generales
.DS_Store
Thumbs.db
*.log

# Archivos y carpetas de Git
.gitattributes

# Ignorar configuraciones de IDEs
.idea/
.vscode/

# --- BACKEND (Spring Boot) ---
# Directorios generados por Maven
target/
factorypath/
# OJO: .mvn/ NO se ignora a propósito: ahí vive el Maven Wrapper (mvnw/mvnw.cmd
# + .mvn/wrapper/maven-wrapper.properties), necesario para que el proyecto
# compile con la misma versión de Maven en cualquier máquina sin instalarlo aparte.

# Archivos de configuración específicos de Eclipse/IDE
.classpath
.project
.settings/

# Archivos de ayuda generados automáticamente
HELP.md

# --- FRONTEND (Angular) ---
# Node.js y Angular
node_modules/
.angular/
dist/
public/

# Archivos de configuración temporales
editorconfig
# OJO: package-lock.json NO se ignora a propósito: fija las versiones exactas
# de las dependencias para que "npm install" instale lo mismo en cualquier máquina.

# --- Generales para proyectos ---
# Archivos de entorno (si usas)
.env
.env.local
.env.*.local


# Archivos TypeScript generados automáticamente
*.tsbuildinfo

# Dumps de base de datos (pueden contener datos reales de producción)
*.dump
*.sql.gz

